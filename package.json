{
  "name": "lantalk",
  "version": "1.0.0",
  "description": "LAN内チャットアプリ",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.lantalk.app",
    "productName": "LanTalk",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "server.js",
      "index.html",
      "style.css",
      "shim.js",
      "sw.js",
      "manifest.webmanifest",
      "icons/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.social-networking",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takoyakidath/lantalk.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/takoyakidath/lantalk/issues"
  },
  "homepage": "https://github.com/takoyakidath/lantalk#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "uuid": "^13.0.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^25.1.8"
  }
}
